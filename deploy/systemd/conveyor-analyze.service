[Unit]
Description=Conveyor Monitor - FFT analysis, watch mode (analyze_fft.py)
After=conveyor-ingest.service
Wants=conveyor-ingest.service

[Service]
Type=simple
# Placeholder: replace with the account this runs as on your Pi.
User=pi
WorkingDirectory=/home/pi/Conveyor-Monitor/backend
# Placeholder: point this at the venv where `pip install -r
# backend/requirements.txt` was run.
ExecStart=/home/pi/Conveyor-Monitor/backend/venv/bin/python3 analyze_fft.py --watch 30
# analyze_fft.py is idempotent (skips already-analyzed windows), so
# restarting after a crash is always safe -- no risk of double-processing.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
